# Frontend environment — copy to frontend/.env.local (gitignored) and edit.
# Read sites: frontend/src/services/index.ts and leaderboardHttp.ts.
# Build-time flags (Vite): set BEFORE `npm run build` / `npm run dev`.

# '1' selects the zero-backend mock leaderboard service (npm run dev with no
# server — already the tracked default in .env.development). Anything else,
# including unset, uses the real HTTP service.
# required: no (optional — defaults to the real HTTP service)
VITE_USE_MOCK_LEADERBOARD=1

# Base URL for the leaderboard API. '' (or unset) = same-origin — the deployed
# pattern where the backend serves the built frontend. Point it at a separately
# running backend in local dev, e.g. http://127.0.0.1:8000 (see AGENTS.md,
# "Leaderboard service modes").
# required: no (optional — defaults to same-origin '')
VITE_API_BASE_URL=
