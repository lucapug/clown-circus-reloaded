# Backend environment — copy to backend/.env (or export in your shell) and edit.
# Read sites: backend/app/config.py. Defaults shown are the code defaults when
# the variable is unset/empty — both variables are optional.

# Postgres (or SQLite) connection string. Unset/empty -> sqlite:///./clowncircus.db
# (a local file, ephemeral inside the container). The deployed environments use a
# Neon Postgres URL stored as a platform secret — never commit a real one.
# required: no (optional — defaults to local SQLite)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated CORS allow-list for the Vite dev origins. Unset/empty ->
# http://localhost:5173,http://127.0.0.1:5173 (the defaults in config.py).
# Set it only when serving the API from a different origin than the defaults.
# required: no (optional — defaults to the two Vite dev origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
