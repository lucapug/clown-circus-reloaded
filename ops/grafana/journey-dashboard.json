{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "description": "Key user journey shape per environment: play (GET /) -> game over -> submit (POST /scores) -> leaderboard (GET /scores). Stated-not-invented: metric stem http_server_request_duration_seconds (verify at first apply; older generation is http_server_duration_*).",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by (deployment_environment_name, http_route) (rate(http_server_request_duration_seconds_count{deployment_environment_name=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{deployment_environment_name}} {{http_route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Request rate per endpoint (play -> submit -> leaderboard)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "description": "p95 server latency per endpoint and environment, from the same auto-instrumented histogram.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, deployment_environment_name, http_route) (rate(http_server_request_duration_seconds_bucket{deployment_environment_name=~\"$env\"}[$__rate_interval])))",
          "legendFormat": "{{deployment_environment_name}} {{http_route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "p95 duration per endpoint",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "description": "5xx share per endpoint and environment. Stated-not-invented: status label http_status_code (same first-apply verify pass as the metric stem; older generation may be status).",
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by (deployment_environment_name, http_route) (rate(http_server_request_duration_seconds_count{deployment_environment_name=~\"$env\", http_status_code=~\"5..\"}[$__rate_interval])) / sum by (deployment_environment_name, http_route) (rate(http_server_request_duration_seconds_count{deployment_environment_name=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{deployment_environment_name}} {{http_route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Error rate per endpoint (5xx share)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "description": "Structured application logs for both environments; the trace_id field carries an internal data link that opens the matching Tempo trace (logs <-> traces correlation by trace ID).",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "internal": {
                      "datasourceUid": "grafanacloud-traces",
                      "panelsState": {
                        "trace": {
                          "spanId": "${__value.raw}"
                        }
                      },
                      "query": "${__value.raw}",
                      "queryType": "traceql"
                    },
                    "title": "Open trace in Tempo",
                    "url": ""
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 4,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "{service_name=~\".+\", deployment_environment_name=~\"$env\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Journey logs (structured; trace_id opens the Tempo trace)",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "grafanacloud-traces"
      },
      "description": "Recent traces from a TraceQL search filtered by environment. Stated-not-invented: the TraceQL attribute form resource.deployment.environment.name — verify in Explore at first apply; if the form differs only this panel empties (metrics/logs panels unaffected).",
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "internal": {
                "datasourceUid": "grafanacloud-traces",
                "panelsState": {
                  "trace": {
                    "spanId": "${__value.raw}"
                  }
                },
                "query": "${__value.raw}",
                "queryType": "traceql"
              },
              "title": "Open trace in Tempo",
              "url": ""
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 5,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "grafanacloud-traces"
          },
          "limit": 20,
          "query": "{resource.deployment.environment.name=~\"$env\"}",
          "queryType": "traceql",
          "refId": "A"
        }
      ],
      "title": "Recent traces (TraceQL search by environment)",
      "type": "traces"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "ccr",
    "m5"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "includeAll": true,
        "label": "Environment",
        "multi": true,
        "name": "env",
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "dev",
            "value": "dev"
          },
          {
            "selected": false,
            "text": "prod",
            "value": "prod"
          }
        ],
        "query": "dev,prod",
        "type": "custom"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "CCR — key user journey (play -> game over -> submit -> leaderboard)",
  "version": 1,
  "weekStart": "",
  "uid": "ccr-journey"
}
