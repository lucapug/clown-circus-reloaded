{
  "uid": "ccr-5xx-user-impact",
  "title": "HTTP 5xx — user impact (CCR)",
  "ruleGroup": "ccr-user-impact",
  "folderUid": "ccr-alerts",
  "for": "2m",
  "noDataState": "OK",
  "execErrState": "Error",
  "data": [
    {
      "refId": "A",
      "relativeTimeRange": { "from": 300, "to": 0 },
      "datasourceUid": "grafanacloud-prom",
      "model": {
        "expr": "sum by (deployment_environment_name) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m]))",
        "instant": true,
        "refId": "A"
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "model": {
        "type": "threshold",
        "expression": "A",
        "conditions": [
          { "evaluator": { "type": "gt", "params": [0] } }
        ]
      }
    }
  ],
  "labels": {
    "environment": "{{ $labels.deployment_environment_name }}",
    "team": "ccr"
  },
  "annotations": {
    "summary": "5xx on {{ $labels.deployment_environment_name }} — user impact",
    "runbook_url": "https://github.com/lucapug/clown-circus-reloaded/blob/main/docs/runbook.md#alert-fired--what-to-do"
  },
  "notification_settings": { "receiver": "ccr-owner-email" }
}
